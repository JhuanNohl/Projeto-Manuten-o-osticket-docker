# ============================================================================
#  MODELO de variáveis de ambiente. Copie para ".env" e preencha os valores:
#      copy .env.example .env        (no CMD/PowerShell, dentro do projeto)
#  NUNCA coloque senhas reais no .env.example (este arquivo pode ir pro git).
# ============================================================================

# ---- Banco de dados ----
DB_NAME=zkteco_manutencao
DB_USER=osticket
DB_PASSWORD=coloque_uma_senha_forte
DB_ROOT_PASSWORD=coloque_uma_senha_root_forte

# ---- Aplicação ----
APP_PORT=8080

# ---- Cloudflare Turnstile (CAPTCHA) ----
# Crie um widget em https://dash.cloudflare.com/ -> Turnstile -> Add Widget
# e cole as duas chaves abaixo. Enquanto vazias, o CAPTCHA fica DESLIGADO
# (não bloqueia ninguém) — é assim que o dev local continua funcionando.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Proxy/CDN confiável (produção atrás do Cloudflare) ----
# Lista separada por vírgula de IPs/CIDR de proxies confiáveis, para que
# X-Forwarded-For/-Proto sejam respeitados (IP real do visitante, detecção
# de HTTPS). Em produção com Cloudflare, use os ranges oficiais publicados
# em https://www.cloudflare.com/ips/ (IPv4 + IPv6). Deixe vazio em dev local.
TRUSTED_PROXIES=

# ---- HTTPS / Let's Encrypt (produção — docker-compose.prod.yml) ----
# Domínio público do helpdesk (DNS já deve apontar para o IP deste servidor
# antes de rodar scripts/init-letsencrypt.sh). Acesso final:
# https://centralmanutencao.zkteco.com.br:4040 (porta 4040 — 80/443 já
# ocupadas por outros sites neste servidor; certificado emitido via DNS-01).
DOMAIN=centralmanutencao.zkteco.com.br
# E-mail para avisos de expiração/renovação do Let's Encrypt.
CERTBOT_EMAIL=coloque_seu_email@zkteco.com.br
